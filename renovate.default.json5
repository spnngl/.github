{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Shared Renovate preset of the spnngl repositories, used with `\"extends\": [\"github>spnngl/.github:renovate.default.json5\"]`.",
    "extends": ["config:best-practices", ":semanticCommits"],
    "timezone": "Europe/Paris",
    "labels": ["dependencies"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Tool versions in workflows and actions, annotated with a `# renovate:` comment on the line above, e.g. `BETTERLEAKS_VERSION: \"1.9.0\"`.",
            "managerFilePatterns": [
                "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/",
                "/(^|/)action\\.ya?ml$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[A-Za-z0-9_-]+: \"?(?<currentValue>[^\"\\s]+)\"?"
            ],
            "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}"
        }
    ],
    "packageRules": [
        {
            "description": "CI dependencies (Actions, container images, tool versions under .github/): automerge non-major updates once CI is green.",
            "matchFileNames": [".github/**"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
            "automerge": true
        },
        {
            "description": "Shared workflows and actions of spnngl/.github are called at @main on purpose: never pin them to a digest.",
            "matchDepNames": ["spnngl/.github"],
            "enabled": false
        }
    ]
}
